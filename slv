#!/bin/perl

use v5.20;

my $case = shift // "input";

open my $in, ".cases" or die;

my $d = [];
my $e = {};

while (<$in>)
{
  if (/^# (.++)/)
  {
    push @$d, $1;
    while (<$in>)
    {
      if (/^$/)
      {
        last;
      }
      else
      {
        push @{$$e{$$d[-1]}}, $_;
      }
    }
  }
}

die if system "dotnet build > /dev/null";

my $grep = [grep {/$case/} @$d];
for (my $i = 0; $i < @$grep; $i++)
{
  say "" if 0 < $i;
  say "#### run case [$$grep[$i]] ####";
  open my $out, "|-", "./bin/Debug/net10.0/work1.exe main" or die;
  for my $j (@{$$e{$$grep[$i]}})
  {
    print $out $j;
  }
  close $out;
}